import React from "react";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { BarChart, Bar, XAxis, YAxis, Tooltip, ResponsiveContainer, CartesianGrid } from "recharts";

export default function BudgetOverviewChart({ projects }) {
  const data = projects.slice(0, 6).map(p => ({
    name: p.name?.length > 15 ? p.name.substring(0, 15) + "…" : p.name,
    budget: p.total_budget || 0,
    spent: p.spent_amount || 0,
  }));

  if (data.length === 0) {
    return (
      <Card>
        <CardHeader><CardTitle className="text-base">Budget Overview</CardTitle></CardHeader>
        <CardContent className="flex items-center justify-center h-48 text-muted-foreground text-sm">
          No budget data yet
        </CardContent>
      </Card>
    );
  }

  const formatAmount = (v) => `R${(v / 1000).toFixed(0)}k`;

  return (
    <Card>
      <CardHeader><CardTitle className="text-base">Budget vs Spent</CardTitle></CardHeader>
      <CardContent>
        <ResponsiveContainer width="100%" height={220}>
          <BarChart data={data} barGap={4}>
            <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="hsl(214, 18%, 90%)" />
            <XAxis dataKey="name" tick={{ fontSize: 11 }} axisLine={false} tickLine={false} />
            <YAxis tickFormatter={formatAmount} tick={{ fontSize: 11 }} axisLine={false} tickLine={false} />
            <Tooltip formatter={(v) => `R${v.toLocaleString()}`} />
            <Bar dataKey="budget" fill="hsl(205, 78%, 35%)" radius={[4, 4, 0, 0]} name="Budget" />
            <Bar dataKey="spent" fill="hsl(168, 55%, 42%)" radius={[4, 4, 0, 0]} name="Spent" />
          </BarChart>
        </ResponsiveContainer>
      </CardContent>
    </Card>
  );
}
